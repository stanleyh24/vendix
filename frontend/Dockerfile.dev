# Dockerfile para desarrollo del frontend con Vite hot-reload
FROM node:20-alpine

WORKDIR /app

# Copiar package files para cachear dependencias
COPY package*.json ./
RUN npm install

# El código fuente se montará como volumen
# No necesitamos copiar el código aquí

EXPOSE 3000

# Ejecutar Vite en modo desarrollo con hot-reload
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]

